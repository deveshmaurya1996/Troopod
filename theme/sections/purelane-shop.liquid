<section
  id="shop"
  class="pl-root pl-sec"
  data-purelane
  data-pl-scene-zone="3"
>
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="pl-rule">
        <i></i>
        {% render 'purelane-icon', icon: 'leaf' %}
        <i></i>
      </div>
    </div>

    <div class="pl-shelf">
      {%- liquid
        assign products = section.settings.product_list
        assign index = 0
      -%}
      {%- if products != blank and products.size > 0 -%}
        {%- for product in products -%}
          {%- assign delay = index | modulo: 4 -%}
          {% render 'purelane-product-card', product: product, reveal_delay: delay %}
          {%- assign index = index | plus: 1 -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' and block.settings.product != blank -%}
            {%- assign delay = index | modulo: 4 -%}
            {% render 'purelane-product-card', product: block.settings.product, reveal_delay: delay %}
            {%- assign index = index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane shop",
  "tag": "section",
  "class": "section-purelane-shop",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 12
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane shop"
    }
  ]
}
{% endschema %}
