<section
  id="reviews"
  class="pl-root pl-sec"
  data-purelane
  data-pl-scene-zone="1"
>
  <div class="pl-wrap">
    <div class="pl-revhead pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.rating_label != blank -%}
        <span class="pl-revhead__agg">
          <span class="pl-revhead__stars" aria-hidden="true">★★★★★</span>
          {{ section.settings.rating_label }}
        </span>
      {%- endif -%}
      {%- if section.settings.homes_label != blank -%}
        <span class="pl-revhead__agg">{{ section.settings.homes_label }}</span>
      {%- endif -%}
    </div>
  </div>

  <div class="pl-revrail pl-rv" data-pl-revrail aria-label="{{ section.settings.rail_label | escape }}">
    <div class="pl-revtrack" data-pl-revtrack data-pl-dup="1">
      {%- for pass in (1..2) -%}
        {%- if section.settings.reviews != blank -%}
          {%- for review in section.settings.reviews -%}
            {%- liquid
              assign title = review.title.value | default: review.title
              assign body = review.body.value | default: review.body
              assign author = review.author.value | default: review.author
              assign product_label = review.product_label.value | default: review.product_label
              assign rating = review.rating.value | default: review.rating | default: 5
              assign stars = '★★★★★'
              if rating == 4
                assign stars = '★★★★'
              elsif rating == 3
                assign stars = '★★★'
              endif
            -%}
            <article class="pl-glass-2 pl-rcard"{% if pass == 2 %} aria-hidden="true"{% endif %}>
              <div class="pl-rcard__stars"{% if pass == 1 %} aria-label="{{ rating }} out of 5"{% endif %}>{{ stars }}</div>
              {%- if title != blank -%}
                <h5 class="pl-rcard__title">{{ title | escape }}</h5>
              {%- endif -%}
              {%- if body != blank -%}
                <p class="pl-rcard__body">{{ body | escape }}</p>
              {%- endif -%}
              <div class="pl-rcard__who">
                {% render 'purelane-icon', icon: 'check' %}
                {%- if author != blank -%}
                  <b>{{ author | escape }}</b>
                {%- endif -%}
                {%- if product_label != blank -%}
                  <span>· {{ product_label | escape }}</span>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              {%- liquid
                assign rating = block.settings.rating | default: 5
                assign stars = '★★★★★'
                if rating == 4
                  assign stars = '★★★★'
                elsif rating == 3
                  assign stars = '★★★'
                endif
              -%}
              <article class="pl-glass-2 pl-rcard"{% if pass == 1 %} {{ block.shopify_attributes }}{% else %} aria-hidden="true"{% endif %}>
                <div class="pl-rcard__stars"{% if pass == 1 %} aria-label="{{ rating }} out of 5"{% endif %}>{{ stars }}</div>
                {%- if block.settings.title != blank -%}
                  <h5 class="pl-rcard__title">{{ block.settings.title | escape }}</h5>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="pl-rcard__body">{{ block.settings.body | escape }}</p>
                {%- endif -%}
                <div class="pl-rcard__who">
                  {% render 'purelane-icon', icon: 'check' %}
                  {%- if block.settings.author != blank -%}
                    <b>{{ block.settings.author | escape }}</b>
                  {%- endif -%}
                  {%- if block.settings.product_label != blank -%}
                    <span>· {{ block.settings.product_label | escape }}</span>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane reviews",
  "tag": "section",
  "class": "section-purelane-reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "html",
      "id": "rating_label",
      "label": "Rating summary",
      "default": "<b>4.8</b> from 8,000+ reviews"
    },
    {
      "type": "html",
      "id": "homes_label",
      "label": "Homes summary",
      "default": "Loved by <b>12 lakh+</b> homes"
    },
    {
      "type": "text",
      "id": "rail_label",
      "label": "Rail aria label",
      "default": "Customer reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Product label",
          "default": "Laundry detergent"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Works like a charm",
            "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author": "Anita",
            "product_label": "Laundry detergent",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Best dishwash ever",
            "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author": "Priya",
            "product_label": "Dishwash gel",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Great product, great packaging",
            "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author": "Sunita",
            "product_label": "Liquid handwash",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Dog friendly",
            "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author": "Rohit S.",
            "product_label": "Floor cleaner",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Sparkling taps again",
            "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "author": "Verified buyer",
            "product_label": "Tap cleaner",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
