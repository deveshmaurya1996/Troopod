<section
  id="bundles"
  class="pl-root pl-sec"
  data-purelane
  data-pl-scene-zone="3"
>
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv" style="margin-bottom:16px">
      <div class="pl-panel-head" style="margin-bottom:0">
        {%- if section.settings.kicker != blank -%}
          <span class="pl-kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.lede != blank -%}
          <p class="pl-lede" style="margin:0 auto">{{ section.settings.lede | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="pl-tiers">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tier' -%}
          {%- liquid
            assign products = block.settings.products
            assign pix_class = 'pl-tier__pix'
            if products != blank and products.size >= 5
              assign pix_class = 'pl-tier__pix pl-tier__pix--five'
            endif
          -%}
          <article
            class="pl-glass pl-tier pl-rv{% if block.settings.featured %} pl-tier--best pl-rv-d2{% elsif forloop.index == 3 %} pl-rv-d3{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.tag != blank -%}
              <span class="pl-tier__tag">{{ block.settings.tag | escape }}</span>
            {%- endif -%}
            {%- if products != blank and products.size > 0 -%}
              <div class="{{ pix_class }}" aria-hidden="true">
                {%- for product in products -%}
                  {%- if product.featured_media -%}
                    {% render 'purelane-media', image: product.featured_media, alt: product.title, width: 160 %}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div class="pl-tier__qty">
              {{ block.settings.qty | escape }}
              <small>{{ block.settings.qty_label | default: 'Products' | escape }}</small>
            </div>
            <div class="pl-tier__price">
              {{ block.settings.price | escape }}
              {%- if block.settings.compare_price != blank -%}
                <s>{{ block.settings.compare_price | escape }}</s>
              {%- endif -%}
            </div>
            {%- if block.settings.per_unit != blank -%}
              <p class="pl-body-s" style="font-size:12px">{{ block.settings.per_unit | escape }}</p>
            {%- endif -%}
            {%- if block.settings.features != blank -%}
              <ul>
                {%- assign feature_lines = block.settings.features | newline_to_br | split: '<br />' -%}
                {%- for line in feature_lines -%}
                  {%- assign clean = line | strip_html | strip -%}
                  {%- if clean != blank -%}
                    <li>
                      {% render 'purelane-icon', icon: 'check' %}
                      {{ clean | escape }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <a
              class="pl-btn {% if block.settings.featured %}pl-btn--primary{% else %}pl-btn--ghost{% endif %}"
              href="{{ block.settings.cta_link | default: section.settings.default_cta_link | default: '#shop' }}"
            >
              {{ block.settings.cta_label | default: 'Build this box' | escape }}
              {%- if block.settings.featured -%}
                {% render 'purelane-icon', icon: 'arrow' %}
              {%- endif -%}
            </a>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane bundles",
  "tag": "section",
  "class": "section-purelane-bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    },
    {
      "type": "url",
      "id": "default_cta_link",
      "label": "Default CTA link"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "text",
          "id": "qty",
          "label": "Quantity",
          "default": "2"
        },
        {
          "type": "text",
          "id": "qty_label",
          "label": "Quantity label",
          "default": "Products"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_unit",
          "label": "Per unit line",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features (one per line)",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Decorative products",
          "limit": 5
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Most popular style",
          "default": false
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Starter",
            "qty": "2",
            "price": "₹349",
            "compare_price": "₹598",
            "per_unit": "Flat ₹174 per product",
            "features": "Pick any two products\nFree shipping across India"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "qty": "3",
            "price": "₹499",
            "compare_price": "₹897",
            "per_unit": "Flat ₹166 per product",
            "features": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India",
            "featured": true
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Whole home",
            "qty": "5",
            "price": "₹799",
            "compare_price": "₹1495",
            "per_unit": "Flat ₹160 per product",
            "features": "Pick any five products\nEvery room in one order\nFree shipping across India"
          }
        }
      ]
    }
  ]
}
{% endschema %}
