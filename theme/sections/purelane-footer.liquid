<footer class="pl-root pl-footer" data-purelane data-pl-scene-zone="4">
  <div class="pl-wrap">
    <div class="pl-fgrid">
      <div class="pl-fcol">
        <a class="pl-brand" href="{{ section.settings.home_link | default: routes.root_url }}" style="margin-bottom:16px">
          <span class="pl-brand__mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
              <path d="M12 21v-6"/>
            </svg>
          </span>
          <span class="pl-brand__txt">
            <span class="pl-brand__n1">{{ section.settings.brand_name | escape }}</span>
            <span class="pl-brand__n2">{{ section.settings.brand_tagline | escape }}</span>
          </span>
        </a>
        {%- if section.settings.blurb != blank -%}
          <p style="max-width:30ch">{{ section.settings.blurb | escape }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div class="pl-fcol" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h5>{{ block.settings.heading | escape }}</h5>
            {%- endif -%}
            {%- if block.settings.link_1_label != blank -%}
              <a href="{{ block.settings.link_1_url | default: '#' }}">{{ block.settings.link_1_label | escape }}</a>
            {%- endif -%}
            {%- if block.settings.link_2_label != blank -%}
              <a href="{{ block.settings.link_2_url | default: '#' }}">{{ block.settings.link_2_label | escape }}</a>
            {%- endif -%}
            {%- if block.settings.link_3_label != blank -%}
              <a href="{{ block.settings.link_3_url | default: '#' }}">{{ block.settings.link_3_label | escape }}</a>
            {%- endif -%}
            {%- if block.settings.link_4_label != blank -%}
              <a href="{{ block.settings.link_4_url | default: '#' }}">{{ block.settings.link_4_label | escape }}</a>
            {%- endif -%}
            {%- if block.settings.link_5_label != blank -%}
              <a href="{{ block.settings.link_5_url | default: '#' }}">{{ block.settings.link_5_label | escape }}</a>
            {%- endif -%}
            {%- if block.settings.link_6_label != blank -%}
              <a href="{{ block.settings.link_6_url | default: '#' }}">{{ block.settings.link_6_label | escape }}</a>
            {%- endif -%}
            {%- if block.settings.note != blank -%}
              <p style="font-size:12px">{{ block.settings.note | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="pl-fbot">
      <span>{{ section.settings.copyright | escape }}</span>
      <span>{{ section.settings.legal | escape }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Purelane footer",
  "tag": "div",
  "class": "section-purelane-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Tagline",
      "default": "Clean, simply"
    },
    {
      "type": "url",
      "id": "home_link",
      "label": "Home link"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "Effective cleaning, powered by nature. Made for Indian homes since day one."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "default": "© 2026 Purelane Eco Products Private Limited"
    },
    {
      "type": "text",
      "id": "legal",
      "label": "Legal line",
      "default": "Privacy · Terms · Refunds · Contact"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "text", "id": "link_1_label", "label": "Link 1 label", "default": "Bestsellers" },
        { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
        { "type": "text", "id": "link_2_label", "label": "Link 2 label" },
        { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
        { "type": "text", "id": "link_3_label", "label": "Link 3 label" },
        { "type": "url", "id": "link_3_url", "label": "Link 3 URL" },
        { "type": "text", "id": "link_4_label", "label": "Link 4 label" },
        { "type": "url", "id": "link_4_url", "label": "Link 4 URL" },
        { "type": "text", "id": "link_5_label", "label": "Link 5 label" },
        { "type": "url", "id": "link_5_url", "label": "Link 5 URL" },
        { "type": "text", "id": "link_6_label", "label": "Link 6 label" },
        { "type": "url", "id": "link_6_url", "label": "Link 6 URL" },
        { "type": "text", "id": "note", "label": "Note" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane footer",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "heading": "Shop",
            "link_1_label": "Bestsellers",
            "link_1_url": "#shop",
            "link_2_label": "Kitchen",
            "link_2_url": "#shop",
            "link_3_label": "Laundry",
            "link_3_url": "#shop",
            "link_4_label": "Home",
            "link_4_url": "#shop",
            "link_5_label": "Skin",
            "link_5_url": "#shop",
            "link_6_label": "Starter kits",
            "link_6_url": "#bundles"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "About",
            "link_1_label": "How it works",
            "link_1_url": "#combos",
            "link_2_label": "Reviews",
            "link_2_url": "#reviews",
            "link_3_label": "Bundles",
            "link_3_url": "#bundles",
            "link_4_label": "Shop",
            "link_4_url": "#shop"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Get in touch",
            "link_1_label": "hello@purelane.com",
            "link_1_url": "mailto:hello@purelane.com",
            "link_2_label": "+91 9930 123 234",
            "link_2_url": "tel:+919930123234",
            "note": "Purelane Eco Products Pvt Ltd"
          }
        }
      ]
    }
  ]
}
{% endschema %}
