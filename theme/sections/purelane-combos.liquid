<section
  id="combos"
  class="pl-root pl-sec"
  data-purelane
  data-pl-scene-zone="3"
>
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="pl-rule">
        <i></i>
        {% render 'purelane-icon', icon: 'leaf' %}
        <i></i>
      </div>
      {%- if section.settings.lede != blank -%}
        <p class="pl-lede" style="margin:14px auto 0">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
    </div>

    <div class="pl-comborail pl-rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'combo' -%}
          {%- liquid
            assign products = block.settings.products
            assign count = 0
            if products != blank
              assign count = products.size
            endif
          -%}
          <article
            class="pl-glass pl-combo{% if block.settings.featured %} pl-combo--featured{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="pl-combo__tray">
              {%- if block.settings.save_label != blank -%}
                <span class="pl-combo__save">{% render 'purelane-badge', label: block.settings.save_label, style: 'save' %}</span>
              {%- endif -%}
              {%- if block.settings.flag != blank -%}
                <span class="pl-combo__flag">{% render 'purelane-badge', label: block.settings.flag, style: 'flag' %}</span>
              {%- endif -%}
              <div class="pl-stack">
                {%- if products != blank and products.size > 0 -%}
                  {%- for product in products -%}
                    {%- unless forloop.first -%}
                      <span class="pl-stack__plus" aria-hidden="true">+</span>
                    {%- endunless -%}
                    <span class="pl-stack__it">
                      {%- if product.featured_media -%}
                        {% render 'purelane-media', image: product.featured_media, alt: product.title, width: 200 %}
                      {%- else -%}
                        <span class="pl-stack__tile">{% render 'purelane-icon', icon: 'leaf' %}</span>
                      {%- endif -%}
                      {%- liquid
                        assign benefit = product.metafields.custom.benefit.value | default: product.metafields.custom.benefit
                        if forloop.index == 1 and block.settings.benefit_1 != blank
                          assign benefit = block.settings.benefit_1
                        elsif forloop.index == 2 and block.settings.benefit_2 != blank
                          assign benefit = block.settings.benefit_2
                        elsif forloop.index == 3 and block.settings.benefit_3 != blank
                          assign benefit = block.settings.benefit_3
                        elsif forloop.index == 4 and block.settings.benefit_4 != blank
                          assign benefit = block.settings.benefit_4
                        elsif forloop.index == 5 and block.settings.benefit_5 != blank
                          assign benefit = block.settings.benefit_5
                        endif
                      -%}
                      <span>{{ benefit | default: product.title | escape }}</span>
                    </span>
                  {%- endfor -%}
                {%- else -%}
                  <span class="pl-stack__it">
                    <span class="pl-stack__tile">{% render 'purelane-icon', icon: 'leaf' %}</span>
                    <span>{{ block.settings.title | escape }}</span>
                  </span>
                {%- endif -%}
              </div>
            </div>
            <div class="pl-combo__body">
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              <div class="pl-combo__cnt">
                {%- if block.settings.count_label != blank -%}
                  {{ block.settings.count_label | escape }}
                {%- else -%}
                  {{ count }} products
                {%- endif -%}
              </div>
              {%- if block.settings.description != blank -%}
                <p class="pl-combo__inc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
              <div class="pl-combo__prow">
                <strong>{{ block.settings.price | escape }}</strong>
                {%- if block.settings.compare_price != blank -%}
                  <s>{{ block.settings.compare_price | escape }}</s>
                {%- endif -%}
                {%- if block.settings.save_chip != blank -%}
                  <em>{{ block.settings.save_chip | escape }}</em>
                {%- endif -%}
              </div>
              {%- if block.settings.fine_print != blank -%}
                <div class="pl-combo__fine">{{ block.settings.fine_print | escape }}</div>
              {%- endif -%}
              <a
                class="pl-btn {% if block.settings.featured %}pl-btn--primary{% else %}pl-btn--ghost{% endif %}"
                href="{{ block.settings.cta_link | default: section.settings.default_cta_link | default: '#bundles' }}"
              >
                {{ block.settings.cta_label | default: 'Shop bundle' | escape }}
                {% render 'purelane-icon', icon: 'arrow' %}
              </a>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.swipe_cue != blank -%}
      <div class="pl-swipecue" aria-hidden="true">
        {% render 'purelane-icon', icon: 'arrow' %}
        {{ section.settings.swipe_cue | escape }}
      </div>
    {%- endif -%}
    {%- if section.settings.rail_note != blank -%}
      <p class="pl-railnote">{{ section.settings.rail_note | escape }}</p>
    {%- endif -%}
  </div>
</section>

